{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serato4SyncPro",
  "version": "1.0.0",
  "identifier": "com.pastteur.serato4syncpro",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Serato 4 Sync Manager Pro",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/**",
          "$HOME/Music/**",
          "$HOME/Downloads/**",
          "/Volumes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../serato_macos_app.py": "serato_macos_app.py",
      "../tag_doctor.py": "tag_doctor.py",
      "../sound_seal.py": "sound_seal.py",
      "../auto_cue.py": "auto_cue.py",
      "../audio_health.py": "audio_health.py",
      "../track_matcher.py": "track_matcher.py",
      "../music_analysis.py": "music_analysis.py",
      "../journal.py": "journal.py",
      "../library_tools.py": "library_tools.py",
      "../duplicates_tool.py": "duplicates_tool.py",
      "../crate_ops.py": "crate_ops.py",
      "../serato_v4_engine.py": "serato_v4_engine.py",
      "../music_library_helper.py": "music_library_helper.py",
      "../fts_library_cache.py": "fts_library_cache.py",
      "../pioneer_usb_exporter.py": "pioneer_usb_exporter.py",
      "../tagger_daemon.py": "tagger_daemon.py",
      "../smart_tags.py": "smart_tags.py",
      "../scan_unused_files.py": "scan_unused_files.py",
      "../beatshift_scanner.py": "beatshift_scanner.py",
      "../key_converter.py": "key_converter.py",
      "../taxonomy_cleaner.py": "taxonomy_cleaner.py",
      "../recipe_engine.py": "recipe_engine.py",
      "../deckwatch_monitor.py": "deckwatch_monitor.py",
      "../bin": "bin",
      "../tools": "tools",
      "../vendor": "vendor"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}